[gd_resource type="NoiseTexture2D" load_steps=2 format=3]

; One seamless fBm tile, shared by every boost pad shader. Baked rather than
; evaluated per fragment: the pads are on screen constantly and there are 34 of
; them, and the mip chain fades the fine detail out with distance instead of
; shimmering across the pitch.

[sub_resource type="FastNoiseLite" id="FastNoiseLite_boost"]
noise_type = 1
seed = 7
frequency = 0.03
fractal_octaves = 4
fractal_gain = 0.62

[resource]
width = 256
height = 256
seamless = true
generate_mipmaps = true
noise = SubResource("FastNoiseLite_boost")
