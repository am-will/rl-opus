[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("SkyMat_1")
radiance_size = 4

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_1")
ambient_light_source = 3
; MEASURED, and it is not what arena_setup.gd's `--ambient` comment implies.
; Scaling this to 0.35 and to 0.55 both produced a `hero` frame identical to
; 1.0 in every one of compare_shots.py's five regions. The night sky is dark,
; so however unoccluded the sky ambient is, it contributes almost nothing
; against 39 lights and the emissive geometry. Left at 1.0: turning it down is
; free, but it is not the thing flattening the frame and should not be
; credited as such.
ambient_light_energy = 1.0
reflected_light_source = 2
tonemap_mode = 4
tonemap_exposure = 0.573
tonemap_agx_contrast = 1.55
ssr_enabled = true
ssr_max_steps = 64
ssr_fade_in = 0.2
ssr_fade_out = 4.0
ssr_depth_tolerance = 0.3
ssao_enabled = true
ssao_radius = 1.6
ssao_intensity = 3.0
ssao_power = 1.6
ssao_detail = 0.4
ssao_horizon = 0.05
ssao_light_affect = 0.05
ssil_enabled = true
ssil_radius = 6.0
ssil_intensity = 1.4
ssil_normal_rejection = 0.7
glow_enabled = true
glow_normalized = true
; The old curve had levels 1-2 OFF and 5-7 at full, which is a wide veil rather
; than a bloom: it greyed the whole frame and gave the boost pads no hot core.
; Weighting the tight levels and pulling the wide ones down puts the glow back
; where the light actually is. The threshold rise stops the pitch itself from
; blooming.
glow_intensity = 0.9
glow_strength = 1.0
glow_bloom = 0.05
glow_blend_mode = 0
glow_hdr_threshold = 1.3
glow_hdr_scale = 1.0
glow_levels/1 = 0.6
glow_levels/2 = 0.8
glow_levels/3 = 0.7
glow_levels/4 = 1.0
glow_levels/5 = 0.4
glow_levels/6 = 0.2
glow_levels/7 = 0.0
volumetric_fog_enabled = false
volumetric_fog_density = 0.0006
volumetric_fog_albedo = Color(0.88, 0.91, 0.98, 1)
volumetric_fog_anisotropy = 0.35
volumetric_fog_length = 350.0
volumetric_fog_detail_spread = 2.5
volumetric_fog_gi_inject = 0.0
volumetric_fog_ambient_inject = 0.0
volumetric_fog_sky_affect = 0.0
adjustment_enabled = true
; Left at 0.95. Raising it to 1.05 looked right on a chase-cam frame and
; measured plainly worse: pitch saturation went from +0.14 over the reference
; to +0.33. Worth knowing that the pitch is ALREADY +0.12/+0.14 over at 0.95 --
; a pre-existing delta nobody has chased, and the wrong thing to chase against
; a rasterised reference.
adjustment_saturation = 0.95

